# Auto detect text files and perform LF normalization
* text=auto

# Shell scripts should always use LF
*.sh text eol=lf

# Markdown
*.md text eol=lf

# Source code
*.py text eol=lf

# Configuration files
*.yml text eol=lf
*.yaml text eol=lf
.env* text eol=lf
.gitignore text eol=lf
.dockerignore text eol=lf

# Binary files
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.pdf binary
*.zip binary
*.tar.gz binary
*.exe binary
*.dll binary
*.so binary